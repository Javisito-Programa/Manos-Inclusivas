Options -Indexes
RewriteEngine On

# ==========================================
# 1. FORZAR HTTPS ESTRICTO (Redirección 301)
# ==========================================
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ==========================================
# 2. CABECERAS DE SEGURIDAD HTTP
# ==========================================
<IfModule mod_headers.c>
    # HSTS: Fuerza conexión segura durante 1 año
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Anti-Clickjacking: Evita incrustar el sitio en iframes externos
    Header always set X-Frame-Options "SAMEORIGIN"

    # Anti-MIME-sniffing: Evita la reinterpretación de tipos de contenido
    Header always set X-Content-Type-Options "nosniff"

    # Referrer Policy: Protege la información de referencia en enlaces
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy: Bloquea acceso a hardware innecesario
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    
    # Política de Seguridad de Contenido (CSP)
    Header always set Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://js.openpay.mx https://sandbox-js.openpay.mx https://translate.google.com https://translate.googleapis.com https://ajax.googleapis.com; connect-src 'self' https://api.openpay.mx https://sandbox-api.openpay.mx https://*.openpay.mx https://translate.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:;"
</IfModule>

# 1. Redirigir index.html y index.php a la raíz limpia (/)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.(html|php)\ HTTP/
RewriteRule ^index\.(html|php)$ / [R=301,L]

# 2. Redirigir URLs que terminan en .html o .php a su versión limpia
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.(html|php)\ HTTP/
# Evitar redirigir si estamos dentro de la carpeta admin para no romper el panel
RewriteCond %{REQUEST_URI} !^/admin/
RewriteRule ^([^.]+)\.(html|php)$ /$1 [R=301,L]

# 3. Servir internamente el archivo .html si existe
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 4. Servir internamente el archivo .php si existe
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]
